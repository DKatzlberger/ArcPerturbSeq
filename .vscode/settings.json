{
  // Explicit path to the R executable inside the container.
  // This avoids VS Code guessing the wrong R binary.
  "r.rpath.linux": "/usr/local/bin/R",

  // Library paths that VS Code’s R language server (LSP) can see.
  // This is a USER-level R library (writable in an immutable container).
  // It contains helper packages like:
  //   - jsonlite        (required by VS Code for introspection)
  //   - languageserver  (provides autocomplete, hover help, diagnostics)
  //   - rlang           (session watcher of VScode)
  //
  // IMPORTANT:
  // - Do NOT include renv libraries here
  // - renv still controls project dependencies via renv.lock
  // - This path is ONLY for editor tooling, not runtime reproducibility
  "r.libPaths": [
    "/home/people/dkatzlberger/R/x86_64-pc-linux-gnu-library/4.5"
  ],

  // Dont use within VScode plot panels
  // Not available for this version of R
  "r.plot.useHttpgd": false
}